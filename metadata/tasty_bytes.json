{
  "project_config": {
    "database": "TASTY_BYTES_ANALYTICS_DB",
    "schema": "INTEGRATIONS",
    "project_name": "FOOD_TRUCK_ANALYTICS_DBT_PROJECT",
    "default_warehouse": "TASTY_BYTES_DBT_WH",
    "default_target": "dev"
  },
  "tasks": [
    {
      "name": "silver_staging_setup",
      "enabled": true,
      "dbt_command": "run --select tag:silver tag:staging tag:utils",
      "depends_on": [],
      "schedule": "USING CRON 0 9-17 * * * UTC"
    },
    {
      "name": "silver_staging_transformation",
      "enabled": true,
      "dbt_command": "run --select tag:silver tag:intermediate",
      "depends_on": [
        "silver_staging_setup"
      ]
    },
    {
      "name": "silver_staging_dataquality",
      "enabled": true,
      "dbt_command": "test --select tag:silver tag:intermediate",
      "depends_on": [
        "silver_staging_transformation"
      ]
    },
    {
      "name": "gold_core_transformation",
      "enabled": true,
      "dbt_command": "run --select tag:gold tag:core",
      "depends_on": [
        "silver_staging_dataquality"
      ]
    },
    {
      "name": "gold_core_dataquality",
      "enabled": true,
      "dbt_command": "test --select tag:gold tag:core",
      "depends_on": [
        "gold_core_transformation"
      ]
    },
    {
      "name": "gold_analytics_transformation",
      "enabled": true,
      "dbt_command": "run --select tag:gold tag:analytics",
      "depends_on": [
        "gold_core_dataquality"
      ]
    },
    {
      "name": "gold_analytics_dataquality",
      "enabled": true,
      "dbt_command": "test --select tag:gold tag:analytics",
      "depends_on": [
        "gold_analytics_transformation"
      ]
    }
  ]
}